# Environment variables & secrets (CRITICAL: Never commit API keys)
.env
*.env
.env.local

# Databases & Runtime State
*.db
*.db-shm
*.db-wal
backend/doculog.db*

# Uploads & Temporary Media
backend/uploads/*
!backend/uploads/.gitkeep
backend/exports/*
!backend/exports/.gitkeep
backend/backups/*
!backend/backups/.gitkeep
test_data/
screenshots/

# Python cache & virtualenvs
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# Node.js & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System generated logs & scratch
*.log
.system_generated/
.agents/
scratch/
test_*.png

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor settings
.idea/
.vscode/
*.swp
*.swo
